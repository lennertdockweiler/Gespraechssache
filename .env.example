# Gesprächssache – Environment Variables (Vorlage, KEINE echten Werte)
#
# Für lokale Entwicklung: Diese Datei zu `.env` kopieren und Werte
# eintragen (`.env` ist in .gitignore und wird nie committet).
#
# Für das Deployment über GitHub Pages (siehe .github/workflows/deploy.yml):
# Diese Website ist ein rein statischer Build ohne Serverlaufzeit. Die
# folgenden Werte müssen deshalb als Repository-Secrets in GitHub
# hinterlegt werden (Settings → Secrets and variables → Actions → "New
# repository secret"), NICHT hier eingetragen. Der Build-Workflow liest
# sie von dort und reicht sie ausschließlich an den Build-Schritt weiter –
# sie landen nie im ausgelieferten HTML/JS.
#
# Fehlt eine Variable, blendet sich der jeweilige Bereich der Website
# automatisch aus (kein Fehler, kein Crash) – siehe src/lib/youtube.ts
# und src/lib/instagram.ts.

# ---------------------------------------------------------------------------
# YouTube Data API v3 (offiziell: https://developers.google.com/youtube/v3)
# ---------------------------------------------------------------------------

# API-Key aus der Google Cloud Console (API "YouTube Data API v3" aktivieren,
# dann Anmeldedaten → API-Schlüssel erstellen; Einschränkung auf diese API
# empfohlen).
YOUTUBE_API_KEY=

# Channel-ID des Gesprächssache-Hauptkanals (nicht der Handle/@-Name).
# Zu finden z.B. über YouTube Studio → Einstellungen → Kanal → Erweitert,
# oder im Seitenquelltext des Kanals als "channelId".
YOUTUBE_CHANNEL_ID_MAIN=

# Channel-ID des zweiten Kanals mit den ungeschnittenen, vollständigen
# Gesprächen ("Uncut"). Treibt den separaten Bereich /ganze-gespraeche/ an
# (siehe src/pages/ganze-gespraeche/) – unabhängig vom Hauptkanal, ohne
# automatische Verknüpfung einzelner Videos zwischen beiden Kanälen.
YOUTUBE_CHANNEL_ID_UNCUT=

# ---------------------------------------------------------------------------
# Instagram API with Instagram Login (offiziell: Meta Graph API für
# Instagram Business-/Creator-Accounts)
# https://developers.facebook.com/docs/instagram-platform
# ---------------------------------------------------------------------------

# Langlebiges Instagram-Access-Token (60 Tage gültig). Muss regelmäßig vor
# Ablauf über GET https://graph.instagram.com/refresh_access_token erneuert
# werden – siehe Abschlussbericht für die genauen Schritte.
INSTAGRAM_ACCESS_TOKEN=

# Numerische Instagram-User-ID des eigenen Business-/Creator-Accounts
# (einmalig z.B. über den offiziellen /me-Endpunkt mit demselben Token
# abgefragt).
INSTAGRAM_USER_ID=

# ---------------------------------------------------------------------------
# Formspree (https://formspree.io) – Versand des "Gast vorschlagen"-Formulars
# ---------------------------------------------------------------------------

# PUBLIC_-Präfix: bewusst KEIN Geheimnis – landet im Client-Bundle (das ist
# bei einer Formular-Ziel-URL normal und unbedenklich). Konto bei
# formspree.io anlegen, neues Formular erstellen, die dort angezeigte
# Endpunkt-URL (Format: https://formspree.io/f/xxxxxxxx) hier eintragen.
PUBLIC_FORMSPREE_ENDPOINT=

# ---------------------------------------------------------------------------
# Newsletter-Versand (Newsletter.astro) – Anbieter: CleverReach
# (cleverreach.com), deutscher Anbieter (Rastede), DSGVO-freundlich, siehe
# Datenschutzerklärung Abschnitt 6.
#
# So kommst du an die URL:
# 1. In CleverReach: Formulare → Anmeldeformular erstellen (Double-Opt-in
#    aktivieren) → Reiter "Quellcode"/"Source code" → "Quellcode kopieren".
# 2. Im kopierten HTML die "action"-URL des <form>-Tags kopieren
#    (Format etwa: https://static.cleverreach.com/f/XXXXX-XXXXX/... oder
#    https://eu2.cleverreach.com/regform/...).
# 3. Prüfen, welchen Feldnamen das E-Mail-Feld dort erwartet (im CleverReach-
#    Quellcode meist name="email") – ggf. das name="email" auf dem Input in
#    Newsletter.astro entsprechend anpassen. Ebenso alle verstecken
#    <input type="hidden">-Felder (Formular-/Listen-ID) aus dem Quellcode in
#    Newsletter.astro übernehmen, sonst ordnet CleverReach die Anmeldung
#    keinem Formular zu.
# ---------------------------------------------------------------------------
PUBLIC_NEWSLETTER_ENDPOINT=

# ---------------------------------------------------------------------------
# Cookie-Banner: Google Analytics (GA4) und Meta-Pixel (CookieBanner.astro,
# src/scripts/tracking.ts). Laden NUR nach aktiver Einwilligung über den
# Cookie-Banner – ohne gesetzte ID passiert für die jeweilige Kategorie
# nichts (kein Cookie, kein Request an Google/Meta).
# ---------------------------------------------------------------------------

# Google Analytics 4 Measurement-ID (Format "G-XXXXXXXXXX"), aus dem
# Google-Analytics-Konto → Verwaltung → Datenstreams.
PUBLIC_GA_MEASUREMENT_ID=

# Meta-Pixel-ID (rein numerisch), aus dem Meta Events Manager.
PUBLIC_META_PIXEL_ID=
