---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';

import SEO from '@/components/SEO.astro';
import ScrollProgress from '@/components/ScrollProgress.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CookieBanner from '@/components/CookieBanner.astro';
import { platforms, siteConfig } from '@/config/site';
import { withBase } from '@/utils/paths';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: 'website' | 'article' | 'video.other';
  noindex?: boolean;
  /** Zusätzliche JSON-LD-Objekte (z.B. VideoObject, BreadcrumbList) je Seite. */
  structuredData?: Record<string, unknown>[];
  /**
   * Überschreibt ausschließlich die Akzentfarb-Tokens für diese Seite
   * (z.B. für A/B-Farbvergleichs-Routen). Wird als CSS-Custom-Property
   * auf <body> gesetzt und kaskadiert dadurch in alle bestehenden
   * Komponenten, ohne dass diese verändert werden müssen.
   */
  accentOverride?: { accent: string; accentSoft: string };
}

const {
  title,
  description,
  path,
  image,
  type = 'website',
  noindex = false,
  structuredData = [],
  accentOverride,
} = Astro.props;

const accentStyle = accentOverride
  ? `--color-accent: ${accentOverride.accent}; --color-accent-soft: ${accentOverride.accentSoft};`
  : undefined;

// `path` kommt von den Seiten als logischer Pfad ohne Unterpfad
// (z.B. "/gespraeche/"). Hier einmal zentral base-path-bewusst gemacht,
// damit einzelne Seiten das nicht selbst tun müssen.
const fullPath = withBase(path);
const homeUrl = siteConfig.siteUrl + withBase('/');

// `sameAs` zieht automatisch alle bereits eingetragenen Plattform-URLs
// (siteConfig.platforms) – sobald dort echte Links stehen, tauchen sie
// hier ohne weiteres Zutun auf und stärken die Entität in Google/KI-
// Wissensgraphen, statt an einer zweiten Stelle separat gepflegt zu werden.
const sameAs = Object.values(platforms)
  .map((platform) => platform.url)
  .filter((url): url is string => Boolean(url));

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.projectName,
  url: homeUrl,
  description: siteConfig.tagline,
  logo: siteConfig.siteUrl + withBase('/favicon-512.png'),
  ...(sameAs.length > 0 && { sameAs }),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.projectName,
  url: homeUrl,
  inLanguage: siteConfig.locale,
};

const allSchemas = [organizationSchema, websiteSchema, ...structuredData];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#18140f" />

    <!-- Verbindung zu den YouTube-Domains früh aufbauen, statt erst wenn
         der Browser das erste Thumbnail/den Facade-Klick entdeckt – spart
         DNS/TLS-Handshake-Zeit für praktisch jede Seite dieser Website. -->
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" crossorigin />

    <SEO title={title} description={description} path={fullPath} image={image} type={type} noindex={noindex} />

    {
      allSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <!--
      View-Transitions API mit progressivem Enhancement: Navigation
      funktioniert vollständig ohne JS/Animation (normale Seitenwechsel),
      bekommt mit Unterstützung aber einen weichen Crossfade statt eines
      harten Cuts. Respektiert automatisch prefers-reduced-motion.
    -->
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col" style={accentStyle}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Zum Inhalt springen
    </a>

    <div class="film-grain" aria-hidden="true"></div>
    <div class="cursor-spotlight" aria-hidden="true"></div>

    <ScrollProgress />
    <Header />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
    <CookieBanner />

    <script>
      import '@/scripts/reveal';
      import '@/scripts/spotlight';
      import '@/scripts/magnetic';
      import '@/scripts/parallax';
      import '@/scripts/ticker';
      import '@/scripts/tracking';
    </script>
  </body>
</html>
