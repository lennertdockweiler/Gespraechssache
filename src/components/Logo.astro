---
// Abstrakte Wort-/Bildmarke: zwei einander zugewandte Striche, die sowohl
// „zwei Menschen im Gespräch" als auch ein aufgeschlagenes Anführungszeichen
// andeuten. Bewusst kein Mikrofon-Klischee. Funktioniert als Icon (z.B.
// Favicon, Social-Avatar) unabhängig von der Wortmarke.
interface Props {
  withWordmark?: boolean;
  class?: string;
}

const { withWordmark = true, class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    width="26"
    height="26"
    viewBox="0 0 26 26"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="shrink-0"
  >
    <path
      d="M4 15.5C4 10.8056 7.80558 7 12.5 7"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    ></path>
    <path
      d="M22 10.5C22 15.1944 18.1944 19 13.5 19"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    ></path>
    <circle cx="4" cy="15.5" r="1.8" fill="currentColor"></circle>
    <circle cx="22" cy="10.5" r="1.8" fill="currentColor"></circle>
  </svg>
  {
    withWordmark && (
      <span class="font-serif text-lg tracking-tight">Gesprächssache</span>
    )
  }
</span>
