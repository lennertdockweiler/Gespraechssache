---
// Inhalt der Startseite, ausgelagert aus src/pages/index.astro für eine
// klare Trennung von Routing und Inhalt.
import Hero from './Hero.astro';
import FeaturedEpisode from './FeaturedEpisode.astro';
import EpisodeCard from './EpisodeCard.astro';
import FormatPipeline from './FormatPipeline.astro';
import PlatformLinks from './PlatformLinks.astro';
import Newsletter from './Newsletter.astro';
import SectionHeading from './SectionHeading.astro';
import InstagramFeed from './InstagramFeed.astro';
import { getGespraeche } from '@/lib/gespraeche';
import { withBase } from '@/utils/paths';

// getGespraeche() vereint redaktionelle Episoden mit automatisch über die
// YouTube Data API geladenen Kanal-Uploads (siehe src/lib/gespraeche.ts) –
// ein neues Video erscheint dadurch ohne weiteres Zutun hier.
const gespraeche = await getGespraeche();
const featured = gespraeche.find((g) => g.curated?.data.featured) ?? gespraeche[0];
const recentGespraeche = gespraeche.filter((g) => g.slug !== featured?.slug).slice(0, 3);
---

<Hero />

{featured && <FeaturedEpisode item={featured} />}

<section class="mx-auto max-w-content px-5 py-16 sm:px-8" data-reveal>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <SectionHeading
      eyebrow="Archiv"
      title="Gespräche entdecken"
      description="Eine wachsende Sammlung von Interviews mit Menschen, die etwas zu erzählen haben."
    />
    <a href={withBase('/gespraeche/')} class="link-animated whitespace-nowrap text-sm font-medium text-accent">
      Alle Gespräche ansehen <span class="arrow-move">→</span>
    </a>
  </div>

  <div class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
    {recentGespraeche.map((item) => <EpisodeCard item={item} />)}
  </div>
</section>

<div class="border-t border-line">
  <FormatPipeline />
</div>

<section class="border-t border-[var(--color-petrol-wash-line)] bg-[var(--color-petrol-wash)]" data-reveal>
  <div class="mx-auto max-w-content px-5 py-16 sm:px-8">
    <SectionHeading
      eyebrow="Kurz gefragt"
      title="Eine Frage. Fremde Menschen. Unerwartete Antworten."
      description="Das Straßenformat von Gesprächssache: kurze, spontane Antworten auf eine wiederkehrende Frage."
    />
    <a
      href={withBase('/kurz-gefragt/')}
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-paper transition-colors duration-400 hover:bg-accent"
    >
      Kurz gefragt ansehen <span class="arrow-move">→</span>
    </a>
  </div>
</section>

<InstagramFeed />

<section class="mx-auto max-w-content px-5 py-16 sm:px-8" data-reveal>
  <SectionHeading
    eyebrow="Überall verfügbar"
    title="Gesprächssache überall hören und sehen"
    align="center"
    class="mx-auto"
  />
  <div class="mt-10">
    <PlatformLinks />
  </div>
</section>

<Newsletter />

<section class="mx-auto max-w-content px-5 py-20 text-center sm:px-8 sm:py-28" data-reveal>
  <h2 class="mx-auto max-w-[22ch] font-serif text-3xl text-ink sm:text-4xl">
    <span class="line-mask"><span style="transition-delay:0ms">Kennst du jemanden,</span></span>
    <span class="line-mask"><span style="transition-delay:80ms">mit dem wir sprechen sollten?</span></span>
  </h2>
  <p class="mx-auto mt-4 max-w-[52ch] text-stone">
    Wir suchen nicht nach dem größten Namen, sondern nach Menschen, die etwas zu erzählen haben.
  </p>
  <a
    href={withBase('/gast-vorschlagen/')}
    class="mt-8 inline-block rounded-full bg-accent px-7 py-3.5 text-sm font-medium text-paper transition-opacity duration-400 hover:opacity-90"
  >
    Gast vorschlagen
  </a>
</section>
