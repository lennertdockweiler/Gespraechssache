---
// Newsletter-Sektion mit echtem (aber optionalem) Backend: sobald
// PUBLIC_NEWSLETTER_ENDPOINT gesetzt ist (siehe .env.example – die
// Formular-Aktions-URL des CleverReach-Anmeldeformulars, Double-Opt-in),
// sendet das Formular tatsächlich ab. Ohne gesetzten Endpoint bleibt es
// beim bisherigen "noch nicht angebunden"-Hinweis – kein Fehler, kein Crash.
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT as string | undefined;
---

<section class="border-y border-line bg-paper-soft" data-reveal>
  <div class="mx-auto max-w-content px-5 py-16 sm:px-8 sm:py-20">
    <div class="mx-auto max-w-xl text-center">
      <h2 class="font-serif text-3xl text-ink sm:text-4xl">Kein Gespräch verpassen.</h2>
      <p class="mt-3 text-stone">
        Neue Episoden, ausgewählte Momente und gelegentliche Notizen aus der Arbeit an
        Gesprächssache – direkt per E-Mail.
      </p>

      <form
        id="newsletter-form"
        data-endpoint={endpoint}
        class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center"
      >
        <label for="newsletter-email" class="sr-only">E-Mail-Adresse</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          placeholder="deine@email.de"
          class="w-full rounded-full border border-line bg-paper px-5 py-3 text-sm text-ink placeholder:text-stone/60 focus:border-accent sm:w-72"
        />
        <!-- Anti-Spam-Honeypot von CleverReach (aus dem Formular-Quellcode
             übernommen): muss exakt so heißen, für echte Nutzer:innen
             unsichtbar bleiben und immer leer sein – ein ausgefüllter Wert
             signalisiert CleverReach einen Bot. -->
        <input
          type="text"
          name="email_confirm"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="sr-only"
        />
        <button
          id="newsletter-submit"
          type="submit"
          class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent"
        >
          Updates erhalten
        </button>
      </form>
      <p id="newsletter-status" class="mt-3 text-xs text-stone" role="status">
        {!endpoint && 'Die Anmeldung ist technisch vorbereitet und startet in Kürze.'}
      </p>
    </div>
  </div>
</section>

<script>
  // Siehe Kommentar in mobile-nav.ts zu init()/"astro:page-load".
  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();

    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const status = document.getElementById('newsletter-status');
    const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement | null;
    const endpoint = form?.dataset.endpoint;

    const onSubmit = async (event: SubmitEvent) => {
      event.preventDefault();
      if (!form) return;

      if (!endpoint) {
        if (status) {
          status.textContent =
            'Newsletter-Anbindung folgt in einer späteren Version. Formular ist technisch vorbereitet.';
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird gesendet …';
      }

      try {
        // "no-cors": CleverReachs Formular-Endpunkt ist auf klassisches
        // Formular-POST/Redirect ausgelegt (kein <form enctype> gesetzt,
        // also Standard-Encoding), nicht auf eine JSON-API – wir können
        // die Antwort deshalb nicht auslesen, werten aber "kein
        // Netzwerkfehler" als Erfolg. Das ist Standardpraxis bei dieser
        // Art Formular. URLSearchParams statt FormData, damit der Body
        // exakt wie ein natives HTML-Formular als
        // application/x-www-form-urlencoded gesendet wird (FormData würde
        // multipart/form-data senden, das CleverReachs Endpunkt nicht
        // erwartet).
        const params = new URLSearchParams();
        for (const [key, value] of new FormData(form).entries()) {
          params.append(key, String(value));
        }
        await fetch(endpoint, {
          method: 'POST',
          mode: 'no-cors',
          body: params,
        });
        form.reset();
        if (status) {
          status.textContent = 'Danke! Bitte bestätige die Anmeldung über den Link in der E-Mail, die dir gleich zugeschickt wird.';
          status.className = 'mt-3 text-xs text-accent';
        }
      } catch {
        if (status) {
          status.textContent = 'Etwas ist schiefgelaufen. Bitte versuche es später erneut.';
          status.className = 'mt-3 text-xs text-accent';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Updates erhalten';
        }
      }
    };

    form?.addEventListener('submit', onSubmit);
    cleanup = () => form?.removeEventListener('submit', onSubmit);
  }

  document.addEventListener('astro:before-swap', () => cleanup?.());
  document.addEventListener('astro:page-load', init);
  init();
</script>
