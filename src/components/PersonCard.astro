---
import type { CollectionEntry } from 'astro:content';
import PlaceholderVisual from './PlaceholderVisual.astro';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const href = `/menschen/${person.slug}/`;
---

<a href={href} class="group block">
  <div class="hover-media rounded-lg">
    <PlaceholderVisual aspect="portrait" label={person.data.name} sublabel={person.data.profession} />
  </div>
  <h3 class="mt-4 font-serif text-lg text-ink group-hover:text-accent">{person.data.name}</h3>
  <p class="mt-0.5 text-sm text-stone">{person.data.profession}</p>
  {person.data.shortQuote && (
    <p class="mt-2 text-sm italic text-stone/80">„{person.data.shortQuote}"</p>
  )}
</a>
