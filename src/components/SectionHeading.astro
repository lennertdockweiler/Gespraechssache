---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
  /**
   * 'h1' auf Seiten, auf denen diese Überschrift die einzige/primäre
   * Seitenüberschrift ist (z.B. Übersichtsseiten ohne eigenen Hero mit
   * eigenem h1) – sonst 'h2' (Standard) für sekundäre Abschnitte auf einer
   * Seite, die bereits ein eigenes h1 hat.
   */
  level?: 'h1' | 'h2';
}

const { eyebrow, title, description, align = 'left', class: className = '', level = 'h2' } = Astro.props;
const Heading = level;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]} data-reveal>
  {eyebrow && (
    <p class="font-mono text-[0.65rem] uppercase tracking-label text-accent">{eyebrow}</p>
  )}
  <Heading class="mt-2 font-serif text-3xl text-ink sm:text-4xl">{title}</Heading>
  {description && <p class="mt-3 text-stone">{description}</p>}
</div>
