---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]} data-reveal>
  {eyebrow && (
    <p class="font-mono text-[0.65rem] uppercase tracking-label text-accent">{eyebrow}</p>
  )}
  <h2 class="mt-2 font-serif text-3xl text-ink sm:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-stone">{description}</p>}
</div>
