---
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PlaceholderVisual from './PlaceholderVisual.astro';

interface Props {
  episode: CollectionEntry<'episodes'>;
  priority?: boolean;
}

const { episode } = Astro.props;
const guest = await getEntry(episode.data.guest);
const href = `/gespraeche/${episode.slug}/`;
const searchable = `${episode.data.title} ${guest?.data.name ?? ''} ${guest?.data.profession ?? ''} ${episode.data.category}`.toLowerCase();
---

<article
  data-episode-card
  data-category={episode.data.category}
  data-searchable={searchable}
  class="group"
>
  <a href={href} class="block">
    <div class="hover-media rounded-lg">
      <PlaceholderVisual
        aspect="video"
        label={episode.data.title}
        sublabel={guest?.data.name}
      />
    </div>
    <div class="mt-4 flex items-start justify-between gap-3">
      <div>
        <p class="font-mono text-[0.65rem] uppercase tracking-label text-accent">
          {episode.data.category}
        </p>
        <h3 class="mt-1 font-serif text-xl leading-snug text-ink group-hover:text-accent">
          {episode.data.title}
        </h3>
        <p class="mt-1 text-sm text-stone">
          {guest?.data.name} · {guest?.data.profession}
        </p>
      </div>
    </div>
    <div class="mt-2 flex items-center gap-3 text-xs text-stone">
      <time datetime={episode.data.date.toISOString()}>
        {episode.data.date.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <span aria-hidden="true">·</span>
      <span>{episode.data.durationCut} (Best of)</span>
    </div>
  </a>
</article>
