---
import { getEntry } from 'astro:content';
import PlaceholderVisual from './PlaceholderVisual.astro';
import type { GespraechItem } from '@/lib/gespraeche';
import { withBase } from '@/utils/paths';

interface Props {
  item: GespraechItem;
  /** Position in einem gleichzeitig erscheinenden Kartenraster – steuert
   *  einen kurzen Stagger-Delay (~80ms/Karte), siehe Brief-Vorgabe für
   *  "gleichzeitig erscheinende Karten". Optional, da EpisodeCard auch
   *  einzeln bzw. ohne Grid-Kontext verwendet wird. */
  index?: number;
}

const { item, index } = Astro.props;
const guest = item.curated ? await getEntry(item.curated.data.guest) : null;
const href = withBase(`/gespraeche/${item.slug}/`);
const searchable = `${item.title} ${guest?.data.name ?? ''} ${guest?.data.profession ?? ''} ${item.category ?? ''}`.toLowerCase();
const episodeNumber = item.curated?.data.episodeNumber;
---

<article
  data-episode-card
  data-category={item.category ?? ''}
  data-searchable={searchable}
  class="group"
  data-reveal
  data-reveal-delay={index !== undefined ? index * 80 : undefined}
>
  <a href={href} class="block">
    <div class="relative overflow-hidden rounded-lg" transition:name={`gespraech-visual-${item.slug}`}>
      <div class="hover-media">
        {
          item.thumbnailUrl ? (
            <img
              src={item.thumbnailUrl}
              alt=""
              loading="lazy"
              decoding="async"
              class="aspect-video w-full rounded-lg object-cover"
            />
          ) : (
            <PlaceholderVisual aspect="video" label={item.title} sublabel={guest?.data.name} />
          )
        }
      </div>
      <div class="card-overlay absolute inset-0" aria-hidden="true" />
      {episodeNumber && (
        <span
          class="episode-number absolute bottom-3 left-3 font-mono text-xs uppercase tracking-label text-paper"
          aria-hidden="true"
        >
          Nr. {episodeNumber}
        </span>
      )}
    </div>
    <div class="mt-4 flex items-start justify-between gap-3">
      <div>
        {item.category && (
          <p class="font-mono text-[0.65rem] uppercase tracking-label text-accent">{item.category}</p>
        )}
        <h3 class="mt-1 inline font-serif text-xl leading-snug text-ink transition-colors duration-400 group-hover:text-accent">
          {item.title}
        </h3>
        <span
          class="mt-1 block h-px w-8 origin-left scale-x-0 bg-accent transition-transform duration-400 ease-out group-hover:scale-x-100"
          aria-hidden="true"
        ></span>
        {guest && (
          <p class="mt-1 text-sm text-stone">
            {guest.data.name} · {guest.data.profession}
          </p>
        )}
      </div>
    </div>
    <div class="mt-2 flex items-center gap-3 text-xs text-stone">
      <time datetime={item.date.toISOString()}>
        {item.date.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {item.curated && (
        <>
          <span aria-hidden="true">·</span>
          <span>{item.curated.data.durationCut} (Best of)</span>
        </>
      )}
    </div>
  </a>
</article>
