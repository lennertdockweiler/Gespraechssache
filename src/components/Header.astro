---
import Logo from './Logo.astro';
import { primaryNav } from '@/config/site';
import { withBase } from '@/utils/paths';

// Astro.url.pathname enthält zur Laufzeit den Unterpfad (z.B.
// "/Gespr-chssache/gespraeche/"); für den Abgleich mit den logischen
// Pfaden aus primaryNav wird er hier wieder entfernt.
const base = import.meta.env.BASE_URL;
const rawPath = Astro.url.pathname;
const currentPath = rawPath.startsWith(base) ? '/' + rawPath.slice(base.length) : rawPath;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header id="site-header" class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur transition-shadow duration-400">
  <div class="mx-auto flex max-w-content items-center justify-between px-5 py-4 sm:px-8">
    <a href={withBase('/')} class="text-ink transition-opacity duration-400 hover:opacity-70">
      <Logo />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Hauptnavigation">
      {
        primaryNav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'link-animated text-sm tracking-widish',
              isActive(item.href) ? 'is-active text-accent font-medium' : 'text-stone hover:text-accent',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <a
        href={withBase('/gast-vorschlagen/')}
        class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-colors duration-400 hover:bg-accent"
      >
        Gast vorschlagen
      </a>
    </div>

    <button
      id="mobile-nav-toggle"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-ink md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="Menü öffnen"
    >
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true">
        <path d="M0 1H20" stroke="currentColor" stroke-width="1.5"></path>
        <path d="M0 7H20" stroke="currentColor" stroke-width="1.5"></path>
        <path d="M0 13H20" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
  </div>

  <style>
    #site-header.is-scrolled {
      box-shadow: 0 8px 24px -18px rgb(24 20 15 / 0.35);
    }

    /* Permanenter Petrol-Unterstrich für den aktiven Nav-Punkt – nutzt
       dieselbe ::after-Mechanik wie .link-animated (siehe global.css),
       bleibt aber unabhängig vom Hover dauerhaft eingefahren. Signalisiert
       "aktuelle Seite" zusätzlich zur Farbe (nicht nur farbcodiert). */
    .link-animated.is-active::after {
      transform: scaleX(1);
      background-color: var(--color-accent);
    }
  </style>
</header>

<!--
  Bewusst AUSSERHALB von <header>: `backdrop-blur` auf dem Header erzeugt
  per Spezifikation einen neuen Containing Block für `position: fixed`-
  Nachfahren (wie jedes `filter`/`backdrop-filter`). Läge das Panel innerhalb
  des Headers, würde `inset-0` sich nur auf die ~72px hohe Header-Box statt
  auf den echten Viewport beziehen – das Menü wäre dann nur ein schmaler
  Streifen oben statt eines vollflächigen Panels.
-->
<div
  id="mobile-nav-panel"
  class="fixed inset-0 z-50 hidden md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
>
  <div class="panel-inner ml-auto flex h-full w-[82%] max-w-sm flex-col bg-paper px-6 py-6 shadow-xl">
    <div class="flex items-center justify-between">
      <Logo />
      <button
        id="mobile-nav-close"
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-ink transition-colors duration-400 hover:border-accent hover:text-accent"
        aria-label="Menü schließen"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 1L15 15M15 1L1 15" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>

    <nav class="mt-10 flex flex-col gap-1" aria-label="Mobile Hauptnavigation">
      {
        primaryNav.map((item, i) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'panel-item border-b border-line py-4 font-serif text-2xl transition-colors duration-400 hover:text-accent',
              isActive(item.href) ? 'text-accent' : 'text-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
            style={`transition-delay:${i * 60}ms`}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={withBase('/gast-vorschlagen/')}
      class="panel-item mt-8 rounded-full bg-ink px-5 py-3 text-center text-sm font-medium text-paper transition-colors duration-400 hover:bg-accent"
      style={`transition-delay:${primaryNav.length * 60 + 40}ms`}
    >
      Gast vorschlagen
    </a>
  </div>
</div>

<style>
  #mobile-nav-panel {
    background-color: rgb(24 20 15 / 0);
    transition: background-color var(--dur-base) var(--ease-editorial);
  }
  #mobile-nav-panel.is-open {
    background-color: rgb(24 20 15 / 0.4);
  }
  #mobile-nav-panel .panel-inner {
    transform: translateX(100%);
    transition: transform var(--dur-base) var(--ease-editorial);
  }
  #mobile-nav-panel.is-open .panel-inner {
    transform: translateX(0);
  }
  #mobile-nav-panel .panel-item {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity var(--dur-fast) var(--ease-editorial),
      transform var(--dur-fast) var(--ease-editorial),
      color var(--dur-base) var(--ease-editorial),
      background-color var(--dur-base) var(--ease-editorial);
  }
  #mobile-nav-panel.is-open .panel-item {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import '@/scripts/mobile-nav';
</script>
