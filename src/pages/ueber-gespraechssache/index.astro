---
import Layout from '@/layouts/Layout.astro';
import PlaceholderVisual from '@/components/PlaceholderVisual.astro';
import { siteConfig } from '@/config/site';

const values = [
  'Fehler', 'Umwege', 'Zweifel', 'Entscheidungen', 'Leidenschaften', 'Erfahrungen', 'Lebenswege', 'Erkenntnisse',
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: siteConfig.siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Über das Projekt', item: siteConfig.siteUrl + '/ueber-gespraechssache/' },
  ],
};
---

<Layout
  title="Über das Projekt"
  description="Warum Gesprächssache? Die Philosophie hinter dem Interviewformat: Menschen Zeit geben, ihre Geschichte ausführlich zu erzählen – nicht nur bekannte Namen, nicht nur Erfolg."
  path="/ueber-gespraechssache/"
  structuredData={[breadcrumbSchema]}
>
  <div class="mx-auto max-w-content px-5 py-16 sm:px-8 sm:py-20">
    <div class="max-w-2xl" data-reveal>
      <p class="font-mono text-[0.65rem] uppercase tracking-label text-accent">Über das Projekt</p>
      <h1 class="mt-2 font-serif text-4xl text-ink sm:text-5xl">Aus Neugier.</h1>
    </div>

    <div class="mt-10 grid gap-12 lg:grid-cols-[1fr_1fr]" data-reveal>
      <div class="max-w-prose text-lg leading-relaxed text-ink/90">
        <p>
          Viele der interessantesten Geschichten begegnen uns nie. Sie stecken in Menschen, an
          denen wir im Alltag vorbeigehen – in ungewöhnlichen Berufen, in stillen Entscheidungen,
          in Umwegen, die niemand von außen sieht.
        </p>
        <p class="mt-5">
          Gesprächssache möchte Menschen Zeit geben, ihre Geschichte ausführlich zu erzählen.
          Nicht nur bekannte Namen. Nicht nur Erfolg.
        </p>
        <p class="mt-5">Auch:</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {values.map((value) => (
            <li class="rounded-full border border-line px-3 py-1 text-sm text-stone">{value}</li>
          ))}
        </ul>
        <p class="mt-6">
          Entscheidend ist nicht Prominenz. Entscheidend ist, ob jemand etwas zu erzählen hat –
          und ob wir bereit sind, lange genug zuzuhören.
        </p>
      </div>

      <div>
        <PlaceholderVisual aspect="portrait" label="Lennert" sublabel="Host von Gesprächssache" class="rounded-xl" />
        <p class="mt-4 text-sm text-stone">
          Host-Portrait folgt. Eine ausführlichere Host-Biografie wird ergänzt, sobald finale
          Inhalte vorliegen.
        </p>
      </div>
    </div>
  </div>
</Layout>
