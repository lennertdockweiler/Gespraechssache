---
// Neue Seite, Vorschlag zur Sichtung: Presse/Media-Kit. Bei Medien-/
// Interviewformaten üblich (schnelle Fakten + Logo-Download für Presse),
// verlinkt bereits von /kontakt/ ("Presse, Kooperationen") – bei Bedarf
// löschen, wenn sie inhaltlich nicht passt.
import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { siteConfig } from '@/config/site';
import { withBase } from '@/utils/paths';
---

<Layout
  title="Presse"
  description="Presse-Informationen zu Gesprächssache: Kurzbeschreibung, Fakten und Logo für Berichterstattung."
  path="/presse/"
>
  <div class="mx-auto max-w-content px-5 py-16 sm:px-8 sm:py-20">
    <SectionHeading eyebrow="Presse" title="Presse &amp; Media-Kit" level="h1" />

    <div class="mt-10 max-w-prose">
      <h2 class="font-serif text-xl text-ink">Kurzbeschreibung</h2>
      <p class="mt-3 text-stone">{siteConfig.tagline} Gesprächssache ist ein deutschsprachiges Long-Form-Interviewformat: ausführliche Gespräche mit Menschen über ihre Arbeit, Entscheidungen und die Geschichten, die sie geprägt haben – ergänzt um das Straßenformat „Kurz gefragt".</p>

      <h2 class="mt-10 font-serif text-xl text-ink">Logo &amp; Grafik</h2>
      <p class="mt-3 text-stone">Für Berichterstattung frei verwendbar, mit Quellenangabe „Gesprächssache":</p>
      <div class="mt-4 flex flex-wrap gap-4">
        <a
          href={withBase('/favicon-512.png')}
          download
          class="rounded-full border border-line px-5 py-2.5 text-sm text-ink transition-colors duration-400 hover:border-accent hover:text-accent"
        >
          Logo (PNG) ↓
        </a>
        <a
          href={withBase('/og/default.png')}
          download
          class="rounded-full border border-line px-5 py-2.5 text-sm text-ink transition-colors duration-400 hover:border-accent hover:text-accent"
        >
          Titelbild (PNG) ↓
        </a>
      </div>

      <h2 class="mt-10 font-serif text-xl text-ink">Presse-Kontakt</h2>
      <p class="mt-3 text-stone">
        Für Interviewanfragen, Kooperationen oder weiteres Material:{' '}
        <a href={withBase('/kontakt/')} class="underline decoration-line hover:text-accent">Kontaktseite</a>.
      </p>
    </div>
  </div>
</Layout>
