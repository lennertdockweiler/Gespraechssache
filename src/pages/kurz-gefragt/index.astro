---
import Layout from '@/layouts/Layout.astro';
import PlaceholderVisual from '@/components/PlaceholderVisual.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config/site';
import { withBase } from '@/utils/paths';

const clips = (await getCollection('streetInterviews')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: siteConfig.siteUrl + withBase('/') },
    { '@type': 'ListItem', position: 2, name: 'Kurz gefragt', item: siteConfig.siteUrl + withBase('/kurz-gefragt/') },
  ],
};
---

<Layout
  title="Kurz gefragt"
  description="Kurz gefragt: das Straßeninterview-Format von Gesprächssache. Eine Frage, fremde Menschen, unerwartete Antworten."
  path="/kurz-gefragt/"
  structuredData={[breadcrumbSchema]}
>
  <div class="mx-auto max-w-content px-5 py-16 sm:px-8 sm:py-20">
    <SectionHeading
      eyebrow="Straßenformat"
      title="Eine Frage. Fremde Menschen. Unerwartete Antworten."
      description="Kurz gefragt bringt Gesprächssache auf die Straße: spontane Fragen an fremde Menschen – über Erfolg, Fehler, Entscheidungen und Lektionen fürs Leben. Kurze, ehrliche Antworten, die manchmal zu einem langen Gespräch führen."
    />

    <div class="mt-14 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {
        clips.map((clip) => (
          <div class="hover-media rounded-lg">
            <PlaceholderVisual aspect="vertical" label={clip.data.question} sublabel={clip.data.personLabel} class="rounded-lg" />
          </div>
        ))
      }
    </div>

    <div class="mt-16 rounded-xl border border-line bg-paper-soft p-8 sm:p-10">
      <h2 class="font-serif text-2xl text-ink">Wo laufen die Clips?</h2>
      <p class="mt-3 max-w-prose text-stone">
        Kurz-gefragt-Clips erscheinen vertikal auf Instagram, TikTok und YouTube Shorts. Sobald
        die Accounts aktiv sind, werden sie hier direkt verlinkt.
      </p>
    </div>
  </div>
</Layout>
