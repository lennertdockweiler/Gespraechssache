---
import Layout from '@/layouts/Layout.astro';
import PlaceholderVisual from '@/components/PlaceholderVisual.astro';
import EpisodeCard from '@/components/EpisodeCard.astro';
import YouTubePlayer from '@/components/YouTubePlayer.astro';
import { getEntry } from 'astro:content';
import { getGespraeche } from '@/lib/gespraeche';
import type { GespraechItem } from '@/lib/gespraeche';
import { siteConfig } from '@/config/site';
import { withBase } from '@/utils/paths';
import { toIso8601Duration } from '@/utils/duration';

export async function getStaticPaths() {
  const items = await getGespraeche();
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props as { item: GespraechItem };
const episode = item.curated; // redaktionelle Anreicherung, falls vorhanden
const { Content } = episode ? await episode.render() : { Content: null };
const guest = episode ? await getEntry(episode.data.guest) : null;

const allItems = await getGespraeche();
const similarItems = item.category
  ? allItems.filter((i) => i.slug !== item.slug && i.category === item.category).slice(0, 3)
  : [];

const path = `/gespraeche/${item.slug}/`;

// Nur bei einem echten (nicht Platzhalter-)Video den offiziellen Embed
// anzeigen – sonst bleibt es beim typografischen Platzhalter. Automatisch
// aus YouTube geladene Einträge haben praktisch immer eine echte Video-ID.
const heroVideoUrl = item.videoId && !episode?.data.placeholder
  ? `https://www.youtube.com/watch?v=${item.videoId}`
  : null;

const platformLinks = episode
  ? [
      { label: 'Geschnittene Version (YouTube)', url: episode.data.youtubeCut },
      { label: 'Ganzes Gespräch (YouTube)', url: episode.data.youtubeFull },
      { label: 'Spotify', url: episode.data.spotify },
      { label: 'Apple Podcasts', url: episode.data.applePodcast },
    ]
  : [];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: siteConfig.siteUrl + withBase('/') },
    { '@type': 'ListItem', position: 2, name: 'Gespräche', item: siteConfig.siteUrl + withBase('/gespraeche/') },
    { '@type': 'ListItem', position: 3, name: item.title, item: siteConfig.siteUrl + withBase(path) },
  ],
};

// VideoObject nur ausspielen, wenn es sich um ein echtes (nicht
// Platzhalter-)Video handelt – es werden keine erfundenen Video-/
// Thumbnail-Daten strukturiert ausgezeichnet. `thumbnailUrl` ist laut
// Google für die Video-Rich-Result-Berechtigung praktisch verpflichtend,
// deshalb hier zusätzlich ein Fallback direkt aus der Video-ID.
const videoSchema = heroVideoUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: item.title,
      description: item.teaser,
      uploadDate: item.date.toISOString(),
      contentUrl: heroVideoUrl,
      embedUrl: `https://www.youtube-nocookie.com/embed/${item.videoId}`,
      thumbnailUrl: item.thumbnailUrl ?? `https://i.ytimg.com/vi/${item.videoId}/hqdefault.jpg`,
      duration: episode?.data.durationFull ? toIso8601Duration(episode.data.durationFull) : undefined,
    }
  : null;

const structuredData = videoSchema ? [breadcrumbSchema, videoSchema] : [breadcrumbSchema];
---

<Layout
  title={item.title}
  description={item.teaser}
  path={path}
  type="video.other"
  structuredData={structuredData}
>
  <article class="mx-auto max-w-content px-5 py-14 sm:px-8 sm:py-20">
    <nav class="text-xs text-stone" aria-label="Breadcrumb">
      <a href={withBase('/gespraeche/')} class="hover:text-accent">Gespräche</a>
      <span aria-hidden="true"> / </span>
      <span>{item.title}</span>
    </nav>

    {
      episode ? (
        <p class="mt-6 font-mono text-[0.65rem] uppercase tracking-label text-accent">
          {episode.data.category} · Episode {episode.data.episodeNumber}
        </p>
      ) : (
        <p class="mt-6 font-mono text-[0.65rem] uppercase tracking-label text-accent">Neu vom YouTube-Kanal</p>
      )
    }
    <h1 class="mt-2 max-w-3xl font-serif text-4xl leading-tight text-ink sm:text-5xl">
      {item.title}
    </h1>
    {guest && (
      <p class="mt-4 text-lg text-stone">
        Mit <a href={withBase(`/menschen/${guest.slug}/`)} class="text-ink underline decoration-line hover:text-accent">{guest.data.name}</a> · {guest.data.profession}
      </p>
    )}

    <div class="mt-10 rounded-xl" data-reveal transition:name={`gespraech-visual-${item.slug}`}>
      {heroVideoUrl ? (
        <YouTubePlayer url={heroVideoUrl} title={item.title} class="rounded-xl" priority />
      ) : item.thumbnailUrl ? (
        <img
          src={item.thumbnailUrl}
          alt={item.title}
          width="480"
          height="270"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-video w-full rounded-xl object-cover"
        />
      ) : (
        <PlaceholderVisual aspect="video" label={item.title} sublabel={guest?.data.name} class="rounded-xl" />
      )}
    </div>

    <div class="mt-10 grid gap-12 lg:grid-cols-[1fr_320px]">
      <div>
        <div class="prose-content max-w-prose text-ink/90">
          {Content ? <Content /> : <p>{item.teaser}</p>}
        </div>

        {episode && episode.data.chapters.length > 0 && (
          <div class="mt-12">
            <h2 class="font-serif text-2xl text-ink">Kapitel</h2>
            <ol class="mt-4 flex flex-col gap-2">
              {episode.data.chapters.map((chapter) => (
                <li class="flex gap-4 border-b border-line py-2 text-sm">
                  <span class="font-mono text-stone">{chapter.timestamp}</span>
                  <span class="text-ink">{chapter.title}</span>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>

      <aside class="flex flex-col gap-6">
        <div class="rounded-xl border border-line p-6">
          <dl class="flex flex-col gap-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-stone">Datum</dt>
              <dd class="text-ink">
                {item.date.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
              </dd>
            </div>
            {episode && (
              <>
                <div class="flex justify-between">
                  <dt class="text-stone">Ganzes Gespräch</dt>
                  <dd class="text-ink">{episode.data.durationFull}</dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-stone">Best of</dt>
                  <dd class="text-ink">{episode.data.durationCut}</dd>
                </div>
              </>
            )}
          </dl>

          <div class="mt-6 flex flex-col gap-2.5">
            {episode ? (
              platformLinks.map((link) =>
                link.url ? (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full bg-ink px-4 py-2.5 text-center text-sm font-medium text-paper transition-colors hover:bg-accent"
                  >
                    {link.label} ↗
                  </a>
                ) : (
                  <span class="rounded-full border border-dashed border-line px-4 py-2.5 text-center text-sm text-stone">
                    {link.label}
                  </span>
                ),
              )
            ) : (
              item.videoId && (
                <a
                  href={`https://www.youtube.com/watch?v=${item.videoId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-full bg-ink px-4 py-2.5 text-center text-sm font-medium text-paper transition-colors hover:bg-accent"
                >
                  Direkt auf YouTube ansehen ↗
                </a>
              )
            )}
          </div>
        </div>

        {episode && episode.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {episode.data.tags.map((tag) => (
              <span class="rounded-full bg-paper-soft px-3 py-1 text-xs text-stone">{tag}</span>
            ))}
          </div>
        )}
      </aside>
    </div>

    {similarItems.length > 0 && (
      <div class="mt-20 border-t border-line pt-14">
        <h2 class="font-serif text-2xl text-ink">Ähnliche Gespräche</h2>
        <div class="mt-8 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {similarItems.map((i, index) => <EpisodeCard item={i} index={index} />)}
        </div>
      </div>
    )}
  </article>
</Layout>
