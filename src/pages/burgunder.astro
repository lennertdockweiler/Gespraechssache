---
// Farbvarianten-Preview (A/B-Vergleich Akzentfarbe). Nicht Teil der
// eigentlichen Seitenstruktur/Navigation – dient nur dem direkten
// Vergleich von Burgunderrot vs. Petrol gegenüber der aktuellen
// Terrakotta-Akzentfarbe. Nutzt exakt dieselbe Startseiten-Komponente
// wie "/", nur mit überschriebenen Akzentfarb-Variablen.
import Layout from '@/layouts/Layout.astro';
import HomeContent from '@/components/HomeContent.astro';
---

<Layout
  title="Gesprächssache – interessante Menschen, gute Fragen, echte Gespräche"
  description="Gesprächssache ist ein deutschsprachiges Long-Form-Interviewformat mit Menschen, die etwas zu erzählen haben – über Arbeit, Entscheidungen, Erfahrungen und die Geschichten, die sie geprägt haben."
  path="/burgunder/"
  noindex={true}
  accentOverride={{ accent: '#8C3F45', accentSoft: '#C08186' }}
>
  <HomeContent />
</Layout>
