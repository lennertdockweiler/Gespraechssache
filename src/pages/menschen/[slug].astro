---
import Layout from '@/layouts/Layout.astro';
import PlaceholderVisual from '@/components/PlaceholderVisual.astro';
import EpisodeCard from '@/components/EpisodeCard.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { getGespraeche } from '@/lib/gespraeche';
import { siteConfig } from '@/config/site';
import { withBase } from '@/utils/paths';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({
    params: { slug: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await render(person);

const allGespraeche = await getGespraeche();
const episodes = allGespraeche.filter((item) => item.curated?.data.guest.id === person.id);

const path = `/menschen/${person.id}/`;

const socialLinks = [
  { label: 'Website', url: person.data.website },
  { label: 'Instagram', url: person.data.socials?.instagram },
  { label: 'TikTok', url: person.data.socials?.tiktok },
  { label: 'LinkedIn', url: person.data.socials?.linkedin },
].filter((link) => link.url);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: siteConfig.siteUrl + withBase('/') },
    { '@type': 'ListItem', position: 2, name: 'Menschen', item: siteConfig.siteUrl + withBase('/menschen/') },
    { '@type': 'ListItem', position: 3, name: person.data.name, item: siteConfig.siteUrl + withBase(path) },
  ],
};

// Person-Schema: hilft Suchmaschinen (und zunehmend auch KI-/Antwort-
// Systemen), Gast und Profil eindeutig als dieselbe Entität zu erkennen,
// statt den Namen nur als Fließtext zu sehen.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.data.name,
  jobTitle: person.data.profession,
  description: person.data.shortQuote ?? undefined,
  url: siteConfig.siteUrl + withBase(path),
  image: person.data.portrait ? siteConfig.siteUrl + person.data.portrait.src : undefined,
  sameAs: socialLinks.map((link) => link.url).filter((url): url is string => Boolean(url)),
};
---

<Layout
  title={person.data.name}
  description={`${person.data.name} – ${person.data.profession}. Porträt und Gespräche bei Gesprächssache.`}
  path={path}
  structuredData={[breadcrumbSchema, personSchema]}
>
  <article class="mx-auto max-w-content px-5 py-14 sm:px-8 sm:py-20">
    <nav class="text-xs text-stone" aria-label="Breadcrumb">
      <a href={withBase('/menschen/')} class="hover:text-accent">Menschen</a>
      <span aria-hidden="true"> / </span>
      <span>{person.data.name}</span>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-[280px_1fr] lg:items-start">
      {
        person.data.portrait ? (
          <Image
            src={person.data.portrait}
            alt={person.data.name}
            widths={[280, 400, 560]}
            sizes="(min-width: 1024px) 280px, 90vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-[4/5] w-full rounded-xl object-cover"
          />
        ) : (
          <PlaceholderVisual aspect="portrait" label={person.data.name} sublabel={person.data.profession} class="rounded-xl" />
        )
      }

      <div>
        <h1 class="font-serif text-4xl text-ink sm:text-5xl">{person.data.name}</h1>
        <p class="mt-2 text-lg text-stone">{person.data.profession}</p>

        {person.data.shortQuote && (
          <blockquote
            class="mt-6 border-l-2 border-accent pl-4 font-serif text-xl italic text-ink/80"
            data-quote-reveal
          >
            „{person.data.shortQuote}"
          </blockquote>
        )}

        <div class="prose-content mt-6 max-w-prose text-ink/90">
          <Content />
        </div>

        {socialLinks.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {socialLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-line px-4 py-2 text-sm text-ink hover:border-accent hover:text-accent"
              >
                {link.label} ↗
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    {episodes.length > 0 && (
      <div class="mt-20 border-t border-line pt-14">
        <h2 class="font-serif text-2xl text-ink">Gespräche mit {person.data.name}</h2>
        <div class="mt-8 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {episodes.map((item, i) => <EpisodeCard item={item} index={i} />)}
        </div>
      </div>
    )}
  </article>
</Layout>

<script>
  import '@/scripts/quote-reveal';
</script>
